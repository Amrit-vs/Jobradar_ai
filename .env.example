# Database
POSTGRES_DB=jobradar
POSTGRES_USER=jobradar
POSTGRES_PASSWORD=change-me
# Host-based backend development. Compose builds its own URL using db:5432.
DATABASE_URL=postgresql+psycopg://jobradar:change-me@localhost:5432/jobradar

# API
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
# Reserved generic-upload setting; resume validation uses MAX_RESUME_SIZE_MB.
MAX_UPLOAD_SIZE_MB=10
MAX_RESUME_SIZE_MB=10
DEVELOPMENT_USER_EMAIL=local-user@jobradar.test
DEVELOPMENT_USER_NAME=Local User

# Matching component weights in [0, 1]; positive sum, normalized at scoring time.
MATCHING_SKILL_WEIGHT=0.6
MATCHING_TEXT_WEIGHT=0.4
